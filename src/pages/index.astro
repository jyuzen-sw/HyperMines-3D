---
import AppHeader from '../components/AppHeader.astro';
import GameWorkspace from '../components/GameWorkspace.astro';
import HowToDialog from '../components/HowToDialog.astro';
import ResultDialog from '../components/ResultDialog.astro';
import '../styles/global.css';

const assetBase = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#008080" />
    <meta name="description" content="立方体の外側からマスを開く、26近傍の3次元マインスイーパー" />
    <title>HyperMines 3D — Voxel Minesweeper</title>
    <link rel="icon" href={`${assetBase}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <div class="ambient ambient-a" aria-hidden="true"></div>
    <div class="ambient ambient-b" aria-hidden="true"></div>
    <AppHeader />
    <main>
      <GameWorkspace />
    </main>
    <HowToDialog />
    <ResultDialog />
    <noscript>このアプリにはJavaScriptとWebGLが必要です。</noscript>
    <script>
      import '../ui/main.ts';
    </script>
  </body>
</html>
